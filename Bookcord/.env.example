# Copy this file to .env.local and replace the placeholders with values from
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required only for server-side avatar administration.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign the eight-hour admin access cookie. The passcode hash is stored
# in Supabase public.app_settings and is never exposed to browser clients.
STAFF_SESSION_SECRET=replace-with-a-long-random-string

# Preferred transactional provider. Brevo can use a verified sender address
# and temporarily replace a free/unverified sender domain with its managed domain.
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Bookcords

# Optional SMTP alternative for bookstore event emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_APP_PASSWORD=your-smtp-password
EMAIL_FROM=Bookcords <sender@example.com>

# Optional fallback provider. A verified domain is required for general recipients.
RESEND_API_KEY=re_your-api-key

# Supabase Auth sends signup confirmation and password-recovery emails separately.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
