# Copy this file to .env.local and replace the placeholders with values from
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required only for server-side avatar administration.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Six numeric digits used by the admin sign-in page.
STAFF_PASSCODE=123456
STAFF_SESSION_SECRET=replace-with-a-long-random-string

# Custom bookstore event emails (restocks, ready reservations, welcome/security notices).
# Supabase Auth sends signup confirmation and password-recovery emails separately.
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=Bookcords <notifications@your-domain.com>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
