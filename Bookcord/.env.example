# Copy this file to .env.local and replace the placeholders with values from
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required only for server-side avatar administration.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign the eight-hour admin access cookie. The passcode hash is stored
# in Supabase public.app_settings and is never exposed to browser clients.
STAFF_SESSION_SECRET=replace-with-a-long-random-string

# Gmail SMTP for bookstore event emails (restocks, ready reservations, welcome/security notices).
# Create a Google app password; never use your normal Google password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM=Bookcords <your-gmail-address@gmail.com>

# Optional fallback provider. A verified domain is required for general recipients.
RESEND_API_KEY=re_your-api-key

# Supabase Auth sends signup confirmation and password-recovery emails separately.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
